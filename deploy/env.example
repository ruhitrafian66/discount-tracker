# Copied to /etc/discount-tracker/env on the server by setup-server.sh (only if missing).
# Edit it there; it is never committed.
HOST=127.0.0.1
PORT=3003
DATA_DIR=/var/lib/discount-tracker
# Branch the pull-deployer follows.
DEPLOY_BRANCH=main
# Weekly offer fetch time, Oslo time (0=Sun, 1=Mon). Default: Monday 01:00.
#FETCH_WEEKDAY=1
#FETCH_HOUR=1
# Accounts. Comma-separated usernames that may change the shared settings (location,
# shops, Kassalapp key). If unset, the first account created is the admin.
#ADMINS=
# If set, creating an account needs this code.
#SIGNUP_CODE=
#MAX_USERS=100
# Kassalapp key from the environment instead of the Settings page.
#KASSAL_KEY=
